# ligula.jp を静的サイトとして配信するための .htaccess（Xserver / Apache）
# 置き場所: public_html/.htaccess （先頭のドットを付けて置く）
# WordPress の書き換えは使わない。WordPress 本体は public_html の外に退避してある。
#
# 【注意】この public_html には、サブドメイン8つのフォルダが同居している
#   （app / coaching / crypto / doc / liguradio / mogula / search / task）。
#   消さないこと。送信スクリプトは --delete を使わない設計にしてある。

# この設定はサブドメインのフォルダにも受け継がれる。
# index.php を使っているサブドメイン（liguradio）があるので、必ず両方書くこと。
# index.html だけにすると、そちらが 403 になる。
DirectoryIndex index.html index.php index.htm

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http → https（旧 .htaccess と同じ書き方。Xserver は nginx で SSL を終端するので
  # REDIRECT_STATUS の条件を付けないとループすることがある）
  RewriteCond %{HTTPS} !on
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # www あり → なし（正規の URL は https://ligula.jp/）
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# 旧サイトから引き継ぐ転送（2026-11-08 時点の .htaccess にあったもの）
Redirect permanent /ligula_search https://search.ligula.jp

ErrorDocument 404 /404.html

# GitHub Pages では付けられなかったぶん、ここでは付ける
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 画像と CSS/JS はしばらく持たせる。HTML は持たせない（直しがすぐ出るように）
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
